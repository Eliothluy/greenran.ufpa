{
  "name": "OpenRAN Brasil \u2013 UX/UI Kit (Professional)",
  "type": "DOCUMENT",
  "styles": {
    "colors": {
      "primary": "#1E40AF",
      "secondary": "#3B82F6",
      "text": "#111827",
      "muted": "#6B7280",
      "background": "#F9FAFB",
      "white": "#FFFFFF"
    },
    "typography": {
      "h1": {
        "fontSize": 48,
        "fontWeight": 700
      },
      "h2": {
        "fontSize": 32,
        "fontWeight": 600
      },
      "body": {
        "fontSize": 16,
        "fontWeight": 400
      }
    },
    "spacing": {
      "section": 96,
      "container": 1200,
      "gridColumns": 12,
      "gutter": 24
    }
  },
  "components": [
    {
      "name": "Button/Primary",
      "autoLayout": true
    },
    {
      "name": "Button/Secondary",
      "autoLayout": true
    },
    {
      "name": "Card/Default",
      "autoLayout": true
    },
    {
      "name": "Navbar",
      "autoLayout": true
    },
    {
      "name": "Footer",
      "autoLayout": true
    }
  ],
  "pages": [
    {
      "name": "Home Desktop",
      "frame": {
        "width": 1440,
        "autoLayout": true,
        "direction": "vertical",
        "children": [
          {
            "component": "Navbar"
          },
          {
            "name": "Hero",
            "autoLayout": true
          },
          {
            "name": "Audience Section",
            "autoLayout": true
          },
          {
            "name": "Capabilities Section",
            "autoLayout": true
          },
          {
            "name": "Testbed Section",
            "autoLayout": true
          },
          {
            "name": "How it Works",
            "autoLayout": true
          },
          {
            "name": "Docs Section",
            "autoLayout": true
          },
          {
            "name": "News Section",
            "autoLayout": true
          },
          {
            "name": "Partners",
            "autoLayout": true
          },
          {
            "component": "Footer"
          }
        ]
      }
    },
    {
      "name": "Mobile",
      "frame": {
        "width": 375,
        "autoLayout": true,
        "direction": "vertical",
        "children": [
          {
            "component": "Navbar"
          },
          {
            "name": "Hero"
          },
          {
            "name": "Stacked Sections"
          },
          {
            "component": "Footer"
          }
        ]
      }
    }
  ]
}